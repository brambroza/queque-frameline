# ---- Supabase (project dedicated to this site) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this deployment (used in booking / driver links and QR codes)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=v0.1.0

# shop_key of the single site row in `shops`. Public routes (/book, /driver, /display) resolve the site from it.
SITE_SHOP_KEY=fameline

# Secret used to derive booking / driver link tokens (HMAC). Falls back to SUPABASE_SERVICE_ROLE_KEY when unset.
# Changing it invalidates every link already sent out.
TOKEN_SECRET=

# Optional: require /display?key=<value> on the yard TV page
DISPLAY_KEY=

# Bearer token for /api/cron/* (called by Supabase pg_cron every minute for auto-call / overdue sweeps)
CRON_SECRET=

# Optional: LINE OA fallbacks (the portal's /portal/line-settings values win when set)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=

# Optional: SMTP for sending DO / booking links by email (leave blank to disable email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
