# ---- Supabase (project dedicated to this site) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this deployment (used in booking / driver links and QR codes)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=v0.1.0

# shop_key of the single site row in `shops`. Public routes (/book, /driver, /display) resolve the site from it.
SITE_SHOP_KEY=fameline

# Bearer token for /api/cron/* (called by Supabase pg_cron every minute for auto-call / overdue sweeps)
CRON_SECRET=

# Optional: SMTP for sending DO / booking links by email (leave blank to disable email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
