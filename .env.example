NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Shared bearer for /api/cron/* (Vercel Cron: subscription-reminders; Supabase pg_cron: booking-reminders).
# Unset = every cron route answers 401. The same value must be stored in Supabase Vault as `cron_secret`.
CRON_SECRET=replace-with-a-long-random-secret

# Google Calendar one-click OAuth (shared QueueBooking OAuth app; tokens remain per shop)
# Production authorized redirect URI: https://queuebooking.com/api/google-calendar/callback
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# Dedicated encryption key is recommended. If omitted, SUPABASE_SERVICE_ROLE_KEY
# is used as the server-side encryption seed and must not be rotated casually.
GOOGLE_TOKEN_ENCRYPTION_KEY=replace-with-a-long-random-secret

LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret
LIFF_ID=your-liff-id
NEXT_PUBLIC_LIFF_ID=https://liff.line.me/your-liff-id
NEXT_PUBLIC_LIFF_BOOKING_ID=your-liff-booking-id
NEXT_PUBLIC_LIFF_MEMBER_ID=your-liff-member-id

# Omise QR Payment (PromptPay)
# ใช้ test keys สำหรับทดสอบ, เปลี่ยนเป็น live keys เมื่อ go-live
# สามารถตั้งค่าได้ทั้ง env-level (ทุกร้าน) หรือรายร้านผ่าน /portal/payment-settings
OMISE_SECRET_KEY=skey_test_xxxxxxxxxxxxxxxxxxx
OMISE_PUBLIC_KEY=pkey_test_xxxxxxxxxxxxxxxxxxx
# Shared secret appended to the Omise webhook URL as ?key=... (Omise does not sign webhooks)
OMISE_WEBHOOK_SECRET=

# Omise Mobile Banking (K PLUS / SCB EASY / KMA / Bualuang / Krungthai NEXT) uses the same
# Omise keys; toggle per shop in /portal/payment-settings. Each bank must be activated on the
# shop's Omise account. Needs PAYMENT_LINK_SECRET + a public https NEXT_PUBLIC_APP_URL (return_uri).

# Bank transfer + slip upload
# HMAC key for public payment links (?t=...). Unset = tokens are not enforced.
# REQUIRED for bank deeplink + Omise mobile banking: the bank-app return page authenticates with this token only.
PAYMENT_LINK_SECRET=

# Bank deeplink payment (SCB Easy / K PLUS) — shop credentials are entered per shop in
# /portal/payment-settings and sealed with this key (AES-256-GCM). Falls back to
# GOOGLE_TOKEN_ENCRYPTION_KEY, then SUPABASE_SERVICE_ROLE_KEY, when unset.
PAYMENT_CREDENTIALS_KEY=
# Which bank adapters may be offered to customers. KBank field names are unverified
# against partner docs, so it ships off until someone with portal access confirms them.
DEEPLINK_SCB_ENABLED=true
DEEPLINK_KBANK_ENABLED=false
# NEXT_PUBLIC_APP_URL must be a public https URL for bank callbacks (use ngrok in dev).
# LINE Login channel id, used to verify LIFF ID tokens on the payment routes.
# Unset = the routes fall back to trusting the claimed line_user_id.
LINE_LOGIN_CHANNEL_ID=

# Signup notification email (Resend)
RESEND_FROM_EMAIL="YourApp <noreply@yourdomain.com>"
SIGNUP_NOTIFY_EMAIL=your-notify-email@example.com
RESEND_API_KEY=re_your_resend_api_key

# Signup notification email (Gmail SMTP + App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM_EMAIL=your-from-email@gmail.com

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
