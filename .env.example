# ---- Supabase (project dedicated to this site) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL of this deployment (used in booking / driver links and QR codes)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=v0.1.0

# shop_key of the single site row in `shops`. Public routes (/book, /driver, /display) resolve the site from it.
SITE_SHOP_KEY=fameline

# Secret used to derive booking / driver link tokens (HMAC). Falls back to SUPABASE_SERVICE_ROLE_KEY when unset.
# Changing it invalidates every link already sent out.
TOKEN_SECRET=

# Optional: require /display?key=<value> on the yard TV page
DISPLAY_KEY=

# Bearer token for /api/cron/* (called by Supabase pg_cron every minute for auto-call / overdue sweeps)
CRON_SECRET=

# Optional: LINE OA fallbacks (the portal's /portal/line-settings values win when set)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LOGIN_CHANNEL_ID=
NEXT_PUBLIC_LIFF_ID=

# Optional: Web Push (VAPID) for the driver page — phone alerts without LINE ("ถึงคิวแล้ว", "เลยเวลานัด").
# Generate once: `npx web-push generate-vapid-keys`. Leave blank to disable (the page then alerts only while open).
# VAPID_SUBJECT = mailto: or https: contact for the push services; defaults to NEXT_PUBLIC_APP_URL when it is https.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional: SMTP for outbound e-mail (feedback reports; DO / booking links later). Leave blank to disable.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_SECURE=false, SMTP_USER=<gmail address>,
#        SMTP_PASS=<16-char App Password from Google Account > Security > 2-Step Verification > App passwords>,
#        SMTP_FROM_EMAIL=<same gmail address>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# Recipient of in-app feedback (bug reports / suggestions from the portal floating button).
# Unset = reports are still stored in feedback_reports but no e-mail is sent.
FEEDBACK_TO_EMAIL=
